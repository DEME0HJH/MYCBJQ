<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/cbjq_gray">

    <!-- 顶部搜索栏 -->
    <androidx.appcompat.widget.SearchView
        android:id="@+id/search_view_role"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/cbjq_text_white"
        android:padding="@dimen/dp_8"
        android:layout_margin="@dimen/dp_8"/>

    <!-- 筛选区（角色专属：定位/星级/元素） -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="@dimen/dp_8"
        android:background="@color/cbjq_text_white"
        android:layout_margin="@dimen/dp_8">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="定位："
            android:textSize="@dimen/text_14"/>

        <!-- 定位筛选标签（步枪/狙击枪/冲锋枪/散弹枪/手枪/双持冲锋/弩/弓/格林机枪） -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginStart="@dimen/dp_8">

            <TextView
                android:id="@+id/filter_assault"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="步枪"
                android:textSize="@dimen/text_14"
                android:padding="@dimen/dp_6"
                android:background="@color/cbjq_filter_selected"
                android:textColor="@color/cbjq_text_white"
                android:layout_marginEnd="@dimen/dp_4"/>

            <TextView
                android:id="@+id/filter_assault"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="狙击枪"
                android:textSize="@dimen/text_14"
                android:padding="@dimen/dp_6"
                android:background="@color/cbjq_filter_selected"
                android:textColor="@color/cbjq_text_white"
                android:layout_marginEnd="@dimen/dp_4"/>

            <TextView
                android:id="@+id/filter_assault"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="冲锋枪"
                android:textSize="@dimen/text_14"
                android:padding="@dimen/dp_6"
                android:background="@color/cbjq_filter_selected"
                android:textColor="@color/cbjq_text_white"
                android:layout_marginEnd="@dimen/dp_4"/>

            <TextView
                android:id="@+id/filter_assault"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="散弹枪"
                android:textSize="@dimen/text_14"
                android:padding="@dimen/dp_6"
                android:background="@color/cbjq_filter_selected"
                android:textColor="@color/cbjq_text_white"
                android:layout_marginEnd="@dimen/dp_4"/>

            <TextView
                android:id="@+id/filter_assault"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="手枪"
                android:textSize="@dimen/text_14"
                android:padding="@dimen/dp_6"
                android:background="@color/cbjq_filter_selected"
                android:textColor="@color/cbjq_text_white"
                android:layout_marginEnd="@dimen/dp_4"/>

            <TextView
                android:id="@+id/filter_assault"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="双持冲锋"
                android:textSize="@dimen/text_14"
                android:padding="@dimen/dp_6"
                android:background="@color/cbjq_filter_selected"
                android:textColor="@color/cbjq_text_white"
                android:layout_marginEnd="@dimen/dp_4"/>

            <TextView
                android:id="@+id/filter_assault"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="弩"
                android:textSize="@dimen/text_14"
                android:padding="@dimen/dp_6"
                android:background="@color/cbjq_filter_selected"
                android:textColor="@color/cbjq_text_white"
                android:layout_marginEnd="@dimen/dp_4"/>

            <TextView
                android:id="@+id/filter_assault"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="弓"
                android:textSize="@dimen/text_14"
                android:padding="@dimen/dp_6"
                android:background="@color/cbjq_filter_selected"
                android:textColor="@color/cbjq_text_white"
                android:layout_marginEnd="@dimen/dp_4"/>

            <TextView
                android:id="@+id/filter_assault"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="格林机枪"
                android:textSize="@dimen/text_14"
                android:padding="@dimen/dp_6"
                android:background="@color/cbjq_filter_selected"
                android:textColor="@color/cbjq_text_white"
                android:layout_marginEnd="@dimen/dp_4"/>

            <!-- 其他筛选标签... -->
        </LinearLayout>
    </LinearLayout>

    <!-- 角色网格列表 -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_role_list"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:padding="@dimen/dp_8"/>

</LinearLayout>