<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/cbjq_gray">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingBottom="@dimen/dp_32">

        <!-- 1. 顶部搜索栏 -->
        <androidx.appcompat.widget.SearchView
            android:id="@+id/search_view"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_32"
            android:layout_marginStart="@dimen/dp_16"
            android:layout_marginTop="@dimen/dp_20"
            android:layout_marginEnd="@dimen/dp_16"
            android:background="@color/cbjq_text_white"
            android:elevation="@dimen/dp_8"
            android:padding="@dimen/dp_8"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <EditText
                android:id="@+id/search_et"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="搜索角色/武器/定位"
                android:textColor="@color/cbjq_text_black"
                android:textSize="@dimen/text_16" />
        </androidx.appcompat.widget.SearchView>

        <!-- 2. 版本焦点轮播区 -->
        <TextView
            android:id="@+id/tv_banner_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_20"
            android:text="版本焦点"
            android:textColor="@color/cbjq_blue"
            android:textSize="@dimen/text_20"
            android:textStyle="bold"
            app:layout_constraintStart_toStartOf="@id/search_view"
            app:layout_constraintTop_toBottomOf="@id/search_view" />

        <!-- 轮播图（用ViewPager2实现） -->
<!--        <androidx.viewpager2.widget.ViewPager2-->
<!--            android:id="@+id/banner_vp2"-->
<!--            android:layout_width="match_parent"-->
<!--            android:layout_height="180dp"-->
<!--            android:layout_marginTop="@dimen/dp_8"-->
<!--            android:clipToPadding="false"-->
<!--            android:paddingStart="@dimen/dp_16"-->
<!--            android:paddingEnd="@dimen/dp_16"-->
<!--            app:layout_constraintTop_toBottomOf="@id/tv_banner_title">-->

<!--        </androidx.viewpager2.widget.ViewPager2>-->
        <!-- 临时替换ViewPager2为静态轮播图（后续再改回ViewPager2+Adapter） -->
        <ImageView
            android:id="@+id/banner_vp2"
            android:layout_width="match_parent"
            android:layout_height="180dp"
            android:layout_marginTop="@dimen/dp_8"
            android:layout_marginStart="@dimen/dp_16"
            android:layout_marginEnd="@dimen/dp_16"
            android:scaleType="centerCrop"
            android:src="@drawable/role_placeholder"
        app:layout_constraintTop_toBottomOf="@id/tv_banner_title" />

        <!-- 版本强势角色TOP3 -->
        <TextView
            android:id="@+id/tv_top3_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_20"
            android:text="版本强势角色TOP3"
            android:textColor="@color/cbjq_blue"
            android:textSize="@dimen/text_20"
            android:textStyle="bold"
            app:layout_constraintStart_toStartOf="@id/search_view"
            app:layout_constraintTop_toBottomOf="@id/banner_vp2" />

        <!-- TOP3角色横向滚动栏 -->
        <HorizontalScrollView
            android:id="@+id/top3_scroll"
            android:layout_width="match_parent"
            android:layout_height="120dp"
            android:layout_marginTop="@dimen/dp_8"
            android:scrollbars="none"
            app:layout_constraintTop_toBottomOf="@id/tv_top3_title">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_marginStart="@dimen/dp_16"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <!-- TOP1角色卡片 -->
                <androidx.cardview.widget.CardView
                    android:layout_width="100dp"
                    android:layout_height="100dp"
                    android:layout_marginEnd="@dimen/dp_16"
                    app:cardCornerRadius="@dimen/radius_12"
                    app:cardElevation="@dimen/dp_8">

                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent">

                        <ImageView
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:scaleType="centerCrop"
                            android:src="@drawable/role_placeholder" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_alignParentBottom="true"
                            android:background="#88000000"
                            android:gravity="center"
                            android:text="安卡希雅"
                            android:textColor="@color/cbjq_text_white"
                            android:textSize="@dimen/text_14" />

                        <TextView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:layout_alignParentTop="true"
                            android:layout_alignParentRight="true"
                            android:layout_margin="4dp"
                            android:background="@drawable/bg_circle_blue"
                            android:gravity="center"
                            android:text="1"
                            android:textColor="@color/cbjq_text_white"
                            android:textSize="@dimen/text_12" />
                        </RelativeLayout>
                </androidx.cardview.widget.CardView>

                <!-- TOP2角色卡片 -->
                <androidx.cardview.widget.CardView
                    android:layout_width="100dp"
                    android:layout_height="100dp"
                    android:layout_marginEnd="@dimen/dp_16"
                    app:cardCornerRadius="@dimen/radius_12"
                    app:cardElevation="@dimen/dp_8">

                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent">

                        <ImageView
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:scaleType="centerCrop"
                            android:src="@drawable/role_placeholder" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_alignParentBottom="true"
                            android:background="#88000000"
                            android:gravity="center"
                            android:text="芬妮"
                            android:textColor="@color/cbjq_text_white"
                            android:textSize="@dimen/text_14" />

                        <TextView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:layout_alignParentTop="true"
                            android:layout_alignParentRight="true"
                            android:layout_margin="4dp"
                            android:background="@color/cbjq_light_blue"
                            android:gravity="center"
                            android:text="2"
                            android:textColor="@color/cbjq_text_white"
                            android:textSize="@dimen/text_12"
                            app:cornerRadius="12dp" />
                    </RelativeLayout>
                </androidx.cardview.widget.CardView>

                <!-- TOP3角色卡片 -->
                <androidx.cardview.widget.CardView
                    android:layout_width="100dp"
                    android:layout_height="100dp"
                    android:layout_marginEnd="@dimen/dp_16"
                    app:cardCornerRadius="@dimen/radius_12"
                    app:cardElevation="@dimen/dp_8">

                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent">

                        <ImageView
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:scaleType="centerCrop"
                            android:src="@drawable/role_placeholder" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_alignParentBottom="true"
                            android:background="#88000000"
                            android:gravity="center"
                            android:text="凯茜娅"
                            android:textColor="@color/cbjq_text_white"
                            android:textSize="@dimen/text_14" />

                        <TextView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:layout_alignParentTop="true"
                            android:layout_alignParentRight="true"
                            android:layout_margin="4dp"
                            android:background="@color/cbjq_gray"
                            android:gravity="center"
                            android:text="3"
                            android:textColor="@color/cbjq_text_black"
                            android:textSize="@dimen/text_12"
                            app:cornerRadius="12dp" />
                    </RelativeLayout>
                </androidx.cardview.widget.CardView>
            </LinearLayout>
        </HorizontalScrollView>

        <!-- 功能快捷入口 -->
        <TextView
            android:id="@+id/tv_function_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_20"
            android:text="功能快捷入口"
            android:textColor="@color/cbjq_blue"
            android:textSize="@dimen/text_20"
            android:textStyle="bold"
            app:layout_constraintStart_toStartOf="@id/search_view"
            app:layout_constraintTop_toBottomOf="@id/top3_scroll" />

        <!-- 功能按钮网格 -->
        <GridLayout
            android:id="@+id/function_grid"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/dp_16"
            android:layout_marginTop="@dimen/dp_8"
            android:layout_marginEnd="@dimen/dp_16"
            android:columnCount="2"
            android:rowCount="2"
            android:useDefaultMargins="true"
            app:layout_constraintTop_toBottomOf="@id/tv_function_title">

            <!-- 角色图鉴 -->
            <androidx.cardview.widget.CardView
                android:layout_width="0dp"
                android:layout_height="80dp"
                android:layout_columnWeight="1"
                android:layout_rowWeight="1"
                app:cardCornerRadius="@dimen/radius_8"
                app:cardElevation="@dimen/dp_8">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:src="@drawable/ic_role" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/dp_8"
                        android:text="角色图鉴"
                        android:textColor="@color/cbjq_text_black"
                        android:textSize="@dimen/text_16"
                        android:textStyle="bold" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- 武器搭配 -->
            <androidx.cardview.widget.CardView
                android:layout_width="0dp"
                android:layout_height="80dp"
                android:layout_columnWeight="1"
                android:layout_rowWeight="1"
                app:cardCornerRadius="@dimen/radius_8"
                app:cardElevation="@dimen/dp_8">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:src="@drawable/ic_weapon" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/dp_8"
                        android:text="武器搭配"
                        android:textColor="@color/cbjq_text_black"
                        android:textSize="@dimen/text_16"
                        android:textStyle="bold" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- 配队推荐 -->
            <androidx.cardview.widget.CardView
                android:layout_width="0dp"
                android:layout_height="80dp"
                android:layout_columnWeight="1"
                android:layout_rowWeight="1"
                app:cardCornerRadius="@dimen/radius_8"
                app:cardElevation="@dimen/dp_8">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:src="@drawable/ic_team" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/dp_8"
                        android:text="配队推荐"
                        android:textColor="@color/cbjq_text_black"
                        android:textSize="@dimen/text_16"
                        android:textStyle="bold" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- 养成攻略 -->
            <androidx.cardview.widget.CardView
                android:layout_width="0dp"
                android:layout_height="80dp"
                android:layout_columnWeight="1"
                android:layout_rowWeight="1"
                app:cardCornerRadius="@dimen/radius_8"
                app:cardElevation="@dimen/dp_8">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:src="@drawable/ic_strategy" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/dp_8"
                        android:text="养成攻略"
                        android:textColor="@color/cbjq_text_black"
                        android:textSize="@dimen/text_16"
                        android:textStyle="bold" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>
        </GridLayout>

        <!-- 底部资讯区 -->
        <TextView
            android:id="@+id/tv_news_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_20"
            android:text="最新资讯"
            android:textColor="@color/cbjq_blue"
            android:textSize="@dimen/text_20"
            android:textStyle="bold"
            app:layout_constraintStart_toStartOf="@id/search_view"
            app:layout_constraintTop_toBottomOf="@id/function_grid" />

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_8"
            android:layout_marginStart="@dimen/dp_16"
            android:layout_marginEnd="@dimen/dp_16"
            app:cardCornerRadius="@dimen/radius_8"
            app:cardElevation="@dimen/dp_8"
            app:layout_constraintTop_toBottomOf="@id/tv_news_title">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/dp_16">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="【版本更新】1.5版本「深空回响」上线，新角色安卡希雅登场！"
                    android:textColor="@color/cbjq_text_black"
                    android:textSize="@dimen/text_16" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp_8"
                    android:text="更新时间：2025-12-11 | 数据来源：尘白禁区官方"
                    android:textColor="@color/cbjq_gray"
                    android:textSize="@dimen/text_12" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>