<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="@dimen/dp_4"
    app:cardCornerRadius="@dimen/radius_8"
    app:cardElevation="@dimen/dp_2">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/dp_8">

        <!-- 角色立绘 -->
        <ImageView
            android:id="@+id/iv_role"
            android:layout_width="match_parent"
            android:layout_height="120dp"
            android:scaleType="centerCrop"
            android:background="@color/cbjq_gray_light"/>

        <!-- 角色核心信息 -->
        <TextView
            android:id="@+id/tv_role_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_4"
            android:textSize="@dimen/text_16"
            android:textStyle="bold"
            android:textColor="@color/cbjq_text_black"/>

        <!-- 武装名 -->
        <TextView
            android:id="@+id/tv_role_armed_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_2"
            android:textSize="@dimen/text_12"
            android:textColor="@color/cbjq_text_gray"/>

        <!-- 武器类型 -->
        <TextView
            android:id="@+id/tv_role_weapon_type"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_2"
            android:textSize="@dimen/text_12"
            android:textColor="@color/cbjq_text_gray"/>

        <!-- 伤害类型 -->
        <TextView
            android:id="@+id/tv_role_damage_type"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_2"
            android:textSize="@dimen/text_12"
            android:textColor="@color/cbjq_text_gray"/>

        <!-- 攻击力 -->
        <TextView
            android:id="@+id/tv_role_attack"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_2"
            android:textSize="@dimen/text_12"
            android:textColor="@color/cbjq_blue"/>

    </LinearLayout>
</androidx.cardview.widget.CardView>